---
import "../../styles/page/index.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../layouts/Section.astro";
import Skills from "../../components/content/skills/Skills.astro";
import ImageSection from "../../layouts/ImageSection.astro";
import { getPostById } from "../../scripts/content";

// @ts-expect-error Vite image query import
import heroSrcset from '../../assets/images/foto-mkuhles.jpg?w=480;768;1200&format=webp;jpeg&as=srcset';
// @ts-expect-error Vite image query import
import heroSrc from '../../assets/images/foto-mkuhles.jpg?w=1200&format=jpeg&as=src';

import { getLangStaticPaths } from "../../i18n/utils";
import Experience from "../../components/content/experience/ExperienceList.astro";
import Education from "../../components/content/education.astro";
import Profile from "../../components/content/profile.astro";


export const getStaticPaths = getLangStaticPaths;
const { lang } = Astro.params;


const {entry: about, Content: About} = await getPostById(`${lang}/about.md`);
const image = {src: heroSrc, srcset: heroSrcset, alt: "Ein Bild von mir.", className: "circle"}
---

<BaseLayout title="Home" lang={lang}>
	<ImageSection type="about" image={image}><About /></ImageSection>
  <Profile />
  <Skills />
  <Experience />
  <Education />
</BaseLayout>
 