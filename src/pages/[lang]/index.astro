---
import "../../styles/page/index.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Skills from "../../components/content/skills/Skills.astro";
import ImageSection from "../../layouts/ImageSection.astro";
import { getPostById } from "../../scripts/content";

// @ts-expect-error Vite image query import
import heroSrcset from '../../assets/images/foto-mkuhles.jpg?w=480;768;1200&format=webp;jpeg&as=srcset';
// @ts-expect-error Vite image query import
import heroSrc from '../../assets/images/foto-mkuhles.jpg?w=1200&format=jpeg&as=src';

import {
  getLangStaticPaths,
  getTranslationFunction,
  getUrlFromRoute,
  LANGS,
} from "../../i18n/utils";
import Experience from "../../components/content/experience/ExperienceList.astro";
import Education from "../../components/content/education.astro";
import Profile from "../../components/content/profile.astro";
import Contact from "../../components/content/contact.astro";
import OnPageNavigation from "../../components/navigation/OnPageNavigation.astro";
import navData from '../../data/navigation.json';
import type { NavEntry } from "../../types/NavItem";
import type { ImageSectionImage } from "../../types/ImageSectionImage";

export const getStaticPaths = getLangStaticPaths;
const { lang } = Astro.params;
const nav = (navData as any).onepager as NavEntry[];
const t = getTranslationFunction(lang as any);
const urlFromRoute = getUrlFromRoute(lang as any);
const alternates = LANGS.map((l) => ({
  lang: l,
  href: urlFromRoute("home", l),
}));

const {entry: about, Content: About} = await getPostById(`${lang}/about.md`);
const heroImage = {
  src: heroSrc,
  srcset: heroSrcset,
  alt: "Ein Bild von mir.",
  className: "circle",
  loading: "eager",
  fetchpriority: "high",
  width: 1491,
  height: 1491,
  sizes: "(max-width: 640px) 50vw, (max-width: 1024px) 40vw, 40vw",
} satisfies ImageSectionImage;
const contactImage: ImageSectionImage = {
  ...heroImage,
  loading: "lazy",
  fetchpriority: "auto",
};
---

<BaseLayout
  title={t("seo.home.title")}
  lang={lang}
  description={t("seo.home.description")}
  ogImage={heroSrc}
  alternates={alternates}
>
	<ImageSection id="me" type="about" image={heroImage}><About /></ImageSection>
  <Profile />
  <Skills />
  <Experience />
  <Education />
  <ImageSection id="contact" type="about" image={contactImage}><Contact /></ImageSection>
  <OnPageNavigation nav={nav} />
</BaseLayout>
 
