---
import { getCollection } from "astro:content";
import { langFromSlug, normalizeSlug } from "../../../i18n/blog";
import type { Lang } from "../../../i18n/types";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import MarkdownSection from "../../../layouts/MarkdownSection.astro";
import Section from "../../../layouts/Section.astro";
import HeroImage from "../../../components/blog/HeroImage.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return posts
    .map((post) => {
      const lang = langFromSlug(post.slug);
      if (!lang) return null;

      return {
        params: { lang, slug: normalizeSlug(post.slug, lang) },
        props: { post },
      };
    })
    .filter(Boolean);
}

const { post } = Astro.props;
const lang = Astro.params.lang as Lang;

if (langFromSlug(post.slug) !== lang) {
  return new Response("Not found", { status: 404 });
}

const { Content } = await post.render();
---

<BaseLayout title={post.data.title} lang={lang}>
  <Section type="section-header" className="pb-0">
    {post.data.heroImage && (
      <HeroImage image={post.data.heroImage} alt={post.data.heroAlt ?? ""} />
    )}   
    <h1 class="mt-1 mb-0.5">{post.data.title}</h1>
    {post.data.description && (<div class="description">{post.data.description}</div>)}
  </Section>
  <MarkdownSection className="pt-1.5">
    <Content />
  </MarkdownSection>
      
</BaseLayout>