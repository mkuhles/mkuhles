---
import { getCollection } from "astro:content";
import { langFromSlug, normalizeSlug } from "../../../i18n/blog";
import type { Lang } from "../../../i18n/types";
import { LANGS } from "../../../i18n/utils";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import MarkdownSection from "../../../layouts/MarkdownSection.astro";
import Section from "../../../layouts/Section.astro";
import HeroImage from "../../../components/blog/HeroImage.astro";
import OnPageNavigation from "../../../components/navigation/OnPageNavigation.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return posts
    .map((post) => {
      const lang = langFromSlug(post.slug);
      if (!lang) return null;

      return {
        params: { lang, slug: normalizeSlug(post.slug, lang) },
        props: { post },
      };
    })
    .filter(Boolean);
}

const { post } = Astro.props;
const lang = Astro.params.lang as Lang;

if (langFromSlug(post.slug) !== lang) {
  return new Response("Not found", { status: 404 });
}

const baseSlug = normalizeSlug(post.slug, lang);
const alternates = LANGS.map((l) => ({
  lang: l,
  href: `/${l}/blog/${baseSlug}`,
}));

const { Content, headings } = await post.render();
const nav = headings
  .filter(h => h.depth === 2 || h.depth === 3)
  .map(h => ({
    id: h.slug,        // wird später zu #slug
    label: h.text,     // Menütext
    depth: h.depth,    // 2 oder 3 (für Einrückung/Style)
  }));
---

<BaseLayout
  title={post.data.title}
  lang={lang}
  description={post.data.description}
  ogImage={post.data.heroImage?.src}
  ogType="article"
  alternates={alternates}
>
  <Section type="section-header" className="pb-0">
    {post.data.heroImage && (
      <HeroImage image={post.data.heroImage} alt={post.data.heroAlt ?? ""} />
    )}   
    <h1 class="post-title">{post.data.title}</h1>
    {post.data.description && (<div class="description">{post.data.description}</div>)}
  </Section>
  <MarkdownSection className="post-content">
    <Content />
  </MarkdownSection>
  <OnPageNavigation nav={nav} />   
</BaseLayout>

<style scoped>
  .post-title {
    margin-top: 0.25rem;
    margin-bottom: 0.125rem;
  }
  .post-content {
    padding-top: 1.5rem;
  }
</style>
