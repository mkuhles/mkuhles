---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MarkdownSection from "../../layouts/MarkdownSection.astro";
import { getPostById } from "../../scripts/content";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }];
}

const { lang } = Astro.params;
const {Content} = await getPostById(`${lang}/privacy.md`);
---

<BaseLayout title="Home" lang={lang}>
  <MarkdownSection type="privacy" className="section--gradient"><Content /></Section>
</BaseLayout>