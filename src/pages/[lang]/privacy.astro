---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MarkdownSection from "../../layouts/MarkdownSection.astro";
import { getUrlFromRoute, LANGS } from "../../i18n/utils";
import { getPostById } from "../../scripts/content";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }];
}

const { lang } = Astro.params;
const {Content} = await getPostById(`${lang}/privacy.md`);
const urlFromRoute = getUrlFromRoute(lang);
const alternates = LANGS.map((l) => ({
  lang: l,
  href: urlFromRoute("privacy", l),
}));
---

<BaseLayout
  title="Privacy Policy"
  lang={lang}
  description="Information on data protection and privacy."
  alternates={alternates}
>
  <MarkdownSection type="privacy" className="section--gradient"><Content /></MarkdownSection>
</BaseLayout>
