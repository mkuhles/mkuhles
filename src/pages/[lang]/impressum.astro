---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MarkdownSection from "../../layouts/MarkdownSection.astro";
import { getUrlFromRoute, LANGS } from "../../i18n/utils";
import { getPostById } from "../../scripts/content";

export function getStaticPaths() {
  return [{ params: { lang: "de" } }];
}

const { lang } = Astro.params;
const {Content} = await getPostById(`${lang}/imprint.md`);
const urlFromRoute = getUrlFromRoute(lang);
const alternates = LANGS.map((l) => ({
  lang: l,
  href: urlFromRoute("imprint", l),
}));
---

<BaseLayout
  title="Impressum"
  lang={lang}
  description="Rechtliche Angaben und Kontaktinformationen."
  alternates={alternates}
>
  <MarkdownSection type="imprint" className="section--gradient"><Content /></MarkdownSection>
</BaseLayout>
