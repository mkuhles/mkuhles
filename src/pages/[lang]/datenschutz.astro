---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../layouts/Section.astro";
import { getPostById } from "../../utils/sections.ts";

export function getStaticPaths() {
  return [{ params: { lang: "de" } }];
}

const { lang } = Astro.params;
const {Content} = await getPostById(`${lang}/privacy.md`);
---

<BaseLayout title="Home" lang={lang}>
  <Section type="privacy" className="section--gradient"><Content /></Section>
</BaseLayout>