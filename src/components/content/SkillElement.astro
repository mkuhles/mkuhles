---
import { getLangFromUrl, getTranslationFunction } from "../../i18n/utils";
import { pickColor, textOn } from "../../scripts/colorUtils";
import FlipCard from "../shared/FlipCard.astro";


const lang = getLangFromUrl(Astro.url);
const t = getTranslationFunction(lang);

const { skill } = Astro.props;
const bgcolor = pickColor(skill.knowledge);
const color = textOn(bgcolor);
const examples = skill.examples?.[lang] || [];

---

<FlipCard className="skill-element circle-element circle" styles=`background-color:${bgcolor};`>
  <div slot="front">
    <div style=`color:${color};background-color:${bgcolor};`>
      {skill.name}
    </div>
  </div>
  <div slot="back">
    <div class="skill-back" style=`color:${color};background-color:${bgcolor};`>
      <div>
        <strong>{skill.name}</strong><br />
        {skill.since && t("since") + " " + skill.since}
        <div class="skill-examples">{examples.join(", ")}</div>
      </div>
    </div>
  </div>
</FlipCard>

<style lang="scss" scoped>
  .skill-back {
    border-radius: 100%;
    line-height: 1.2;
    @media (min-width:550px) {
      font-size: .9em;
    }
    
    @media (min-width:550px) {
      padding:  calc(var(--circle-element-padding) *2);
      width: calc(var(--circle-element-diameter) * 2);
      height: calc(var(--circle-element-diameter) * 2);

      display: flex;
      justify-content: center;
      align-items: center;
    }
    
    .skill-examples {
      margin-top: .5em;
      font-size: .9em;
    }
  }

  .flip-card .skill-back {
    opacity: 0;
    transition: 1s ease opacity;
  }
  .flip-card:hover .skill-back,
  .flip-card:focus .skill-back,
  .flip-card:focus-within .skill-back {
    opacity: 1;
  }
</style>