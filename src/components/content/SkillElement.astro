---
import { pickColor, textOn } from "../../scripts/colorUtils";
import FlipCard from "../shared/FlipCard.astro";


const { skill, lang } = Astro.props;
const bgcolor = pickColor(skill.knowledge);
const color = textOn(bgcolor);
const examples = skill.examples?.[lang] || [];

---

<FlipCard className="skill-element circle-element circle" styles=`background-color:${bgcolor};`>
  <div slot="front">
    <div style=`color:${color};background-color:${bgcolor};`>
      {skill.name}
    </div>
  </div>
  <div slot="back">
    <div class="skill-back" style=`color:${color};background-color:${bgcolor};`>
      <strong>{skill.name}</strong> {skill.since && "since "+skill.since}<br />
      <div class="skill-examples">{examples.join(", ")}</div>
    </div>
  </div>
</FlipCard>

<style lang="scss" scoped>
  .skill-back {
    border-radius: 100%;
    line-height: 1.2;
    font-size: .9em;
    padding: 3vmin;
    width: calc(var(--circle-element-diameter) * 1.5);
    height: calc(var(--circle-element-diameter) * 1.5);

    .skill-examples {
      margin-top: .5em;
      font-size: .8em;
    }
  }

  .flip-card .skill-back {
    opacity: 0;
    transition: 1s ease opacity;
  }
  .flip-card:hover .skill-back,
  .flip-card:focus .skill-back,
  .flip-card:focus-within .skill-back {
    opacity: 1;
  }
</style>