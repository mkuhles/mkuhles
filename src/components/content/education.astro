---
import { getLangFromUrl, getTranslationFunction } from "../../i18n/utils";
import Section from "../../layouts/Section.astro";
import ExperienceHeader from "./experience/ExperienceHeader.astro";
import {education} from "../../data/mkuhles.json";

const entry = education[0];
const curLang = getLangFromUrl(Astro.url);
const t = getTranslationFunction(curLang);
---

<Section type="education" className="experience py-2">
  <h2 class="mb-2">{t("education")}</h2>
  <ExperienceHeader
      title={t(entry.degree)} 
      subtitle={entry.institution} 
      startDate={entry.start_date} 
      endDate={entry.end_date}
      className="mb-1"
    />
</Section>