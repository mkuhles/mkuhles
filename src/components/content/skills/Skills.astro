---
import SkillElement from "./SkillElement.astro";
import {skills} from "../../../data/mkuhles.json";
import { getLangFromUrl, getTranslationFunction } from "../../../i18n/utils";
import AgainButton from "../../shared/buttons/AgainButton.astro";
import Scale from "./Scale.astro";
import Section from "../../../layouts/Section.astro";

const lang = getLangFromUrl(Astro.url);
const t = getTranslationFunction(lang);
---
<Section type="skills" className="skills">
  <div class="skill-inner flex flex-col gap-2 items-center">
    <Scale />
    <div id="circle-container" class="circle-container">
      <div class="center-element">{t('skills.myskills')}</div>
      {skills.map( (skill) => <SkillElement skill={skill} className="circle-element"/> )}
    </div>
  </div>
  <div class="skill-footer pt-1 flex justify-around">
    <AgainButton id="reanimateSkills" />
  </div>
</Section>

<style>
.skill-inner {
  @media (--medium-up) {
    flex-direction: row;
    justify-content: space-between;
  }
}
.skill-footer {
  @media (--medium-up) {
    justify-content: end;
  }
}
#circle-container {
  position: relative;
  width: var(--circle-diameter);
  height: var(--circle-diameter);
  overflow: hidden;
  @media (--medium-up) {
    overflow: visible;
  }

  .circle-element {
    position: absolute;
    width: var(--circle-element-diameter);
    height: var(--circle-element-diameter);
    border-radius: 50%;

    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    font-size: var(--circle-element-font-size);
    box-sizing: border-box;
    
    opacity: 0;
  }

  .circle-element-front {
    padding: var(--circle-element-padding);
  }

  .center-element {
    font-size: calc(1.5 * var(--circle-element-font-size));
    z-index: 100;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
}
</style>

<script>
  import initCircleAnimationOnView from '../../../scripts/skills/viewObserver';

  const anim = initCircleAnimationOnView();

  const reanimateSkillsButton = document.getElementById("reanimateSkills");
  reanimateSkillsButton?.addEventListener('click', () => {
    anim.startAnimation();
  });

</script>