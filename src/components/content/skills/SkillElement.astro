---
import { getLangFromUrl, getTranslationFunction } from "../../../i18n/utils";
import { pickColor, textOn } from "../../../scripts/colorUtils";
import FlipCard from "../../shared/FlipCard.astro";


const lang = getLangFromUrl(Astro.url);
const t = getTranslationFunction(lang);

const { skill, className } = Astro.props;
const bgcolor = pickColor(skill.knowledge);
const color = textOn(bgcolor);
const examples = skill.examples?.[lang] || [];

---

<FlipCard className={"skill-element "+className} styles=`color:${color};background-color:${bgcolor};`>
  <div slot="front" class={"skill-element-front "+className+"-front"}>
      {skill.name}
  </div>
  <div slot="back" class={"skill-element-back "+className+"-back"}>
    <div>
      <div class="skill-title">{skill.name}</div>
      {skill.since && t("since") + " " + skill.since}
      <div class="skill-examples">{examples.join(", ")}</div>
    </div>
  </div>
</FlipCard>

<style scoped>
  .skill-element-back {
    line-height: 1.2;
    
  }
  .skill-title {
    font-weight: bold;
    font-size: 1.2em;
  }
  .skill-examples {
    margin-top: .5em;
    font-size: .9em;
  }
</style>