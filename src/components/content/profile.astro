---
import { getLangFromUrl, getTranslationFunction } from "../../i18n/utils";
import Section from "../../layouts/Section.astro";
import {profile} from "../../data/mkuhles.json";

const curLang = getLangFromUrl(Astro.url);
const t = getTranslationFunction(curLang);
---

<Section id="profile" type="profile" className="profile-section">
    <h2 class="profile-title">{t(profile.title)}</h2>
    <div class="profile-statement">{t(profile.statement)}</div>
    <ul class="ul-orange">
        {profile.bullets.map((bullet) => (
            <li>{t(bullet)}</li>
        ))}
    </ul>
</Section>

<style scoped>
  .profile-title {
    margin-bottom: 0.5rem;
  }
  .profile-statement {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }
</style>
