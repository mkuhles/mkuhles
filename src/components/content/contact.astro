import {contact} from "../../data/mkuhles.json";

const base = import.meta.env.BASE_URL;
const iconMap: Record<string, string> = {
    github: `${base}images/github.png`,
    linkedin: `${base}images/linkedin.png`,
};
---

<>
    <div class="name">{contact.full_name}</div>
    <div class="email">
        <a class="email-link" href={"mailto:"+contact.email}>{contact.email}</a>
    </div>
    <div class="socials">
        {contact.socials.map((social) => (
            social.url && (
                <a
                    href={social.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-link"
                >
                    <img
                        src={iconMap[social.platform]}
                        alt=""
                        class="social-icon"
                    />
                    <span class="sr-only">{social.url}</span>
                </a>
            )
        ))}
    </div>
</>

<style scoped>
    .socials {
        display: flex;
        gap: 0.25rem;
        margin: 0.25rem 0;
        justify-content: center;
    }
    @media (--small-up) {
        .socials {
            justify-content: flex-start;
        }
    }
    .social-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: .5rem;
    }
    .social-icon {
        width: 2rem;
        height: 2rem;
        transition: transform 150ms ease, filter 150ms ease;
    }
    .social-link:hover .social-icon {
        transform: scale(1.1);
        filter: brightness(0.9);
    }
</style>
