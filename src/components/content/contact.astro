---
type ContactValue = {
    title?: string,
    url?: string,
    external?: boolean
}

import {contact} from "../../data/mkuhles.json";

const iconMap: Record<string, string> = {
    github: "/images/github.png",
    linkedin: "/images/linkedin.png",
};
---

<>
    <div class="name">{contact.name.value}</div>
    <div class="email">
        <a href={"mailto:"+contact.email.value}>{contact.email.value}</a>
    </div>
    <div class="socials">
        {Object.entries(contact.social).map(([key, value]) => (
            value.url && (
                <a
                    href={value.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-link"
                >
                    <img
                        src={iconMap[key]}
                        alt=""
                        class="social-icon"
                    />
                    <span class="sr-only">{value.url}</span>
                </a>
            )
        ))}
    </div>
</>

<style scoped>
    .socials {
        display: flex;
        gap: 0.25rem;
        margin: 0.25rem 0;
        justify-content: center;
    }
    @media (--small-up) {
        .socials {
            justify-content: flex-start;
        }
    }
    .social-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
    }
    .social-icon {
        width: 2rem;
        height: 2rem;
        transition: transform 150ms ease, filter 150ms ease;
    }
    .social-link:hover .social-icon {
        transform: scale(1.1);
        filter: brightness(0.9);
    }
</style>
