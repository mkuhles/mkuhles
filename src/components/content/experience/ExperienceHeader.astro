---
import { getLangFromUrl, getTranslationFunction } from "../../../i18n/utils";

interface Props {
  title: string,
  subtitle?: string,
  startDate: string,
  endDate?: string | null,
  level?: number,
  className?: string
}

const {title, subtitle, startDate, endDate, level = 3, className = ''} = Astro.props;
const curLang = getLangFromUrl(Astro.url);
const t = getTranslationFunction(curLang);

const start = new Date(startDate).toLocaleDateString(curLang, { year: 'numeric', month: 'long' });
const end = endDate ? new Date(endDate).toLocaleDateString(curLang, { year: 'numeric', month: 'long' }) : t("today");
---


<div class={"experience__header "+className}>
  <div class="experience-header__row">
    {level == 3 
      ? <h3 class="">{title}</h3> 
      : level == 4 
        ? <h4 class="experience-header__title--accent">{title}</h4> 
        : <h5 class="">{title}</h5>}
    <div class="experience-header__dates">{start} - {end}</div>
  </div>
  <div class="">{subtitle}</div>
</div>

<style lang="scss" scoped>
  .prose .experience__header {
    h3 {
      margin-bottom: 0;
    }
  }
  .experience-header__row {
    @media (--small-up) {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }
  }
  .experience-header__title--accent {
    color: var(--c11);
  }
  .experience-header__dates {
    @media (--small-up) {
      text-align: right;
    }
  }
</style>
