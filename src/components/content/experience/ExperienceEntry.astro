---
import { getLangFromUrl, getTranslationFunction } from "../../../i18n/utils";
import Section from "../../../layouts/Section.astro";
import ExperienceDescription from "./ExperienceDescription.astro";
import ExperienceHeader from "./ExperienceHeader.astro";
import ExperienceProject from "./ExperienceProject.astro";
import ExperienceTechnologies from "./ExperienceTechnologies.astro";
import type { ExperienceEntryData, ExperienceProjectData } from "../../../types/MkuhlesData";

interface Props {
  entry: ExperienceEntryData;
}

const {entry} = Astro.props as Props;
const curLang = getLangFromUrl(Astro.url);
const t = getTranslationFunction(curLang);
---

<Section type="experience-entry" className="py-2">
  <ExperienceHeader 
    title={t(entry.role)} 
    subtitle={entry.company} 
    startDate={entry.start_date} 
    endDate={entry.end_date}
    className="mb-1"
  />
  {entry.description &&
    <ExperienceDescription description={entry.description} />}
  {entry.projects && (
    <ul>
      {entry.projects?.map((project: ExperienceProjectData) => (
        <li><ExperienceProject project={project} /></li>
      ))}
    </ul>
  )}
  {entry.technologies &&
    <ExperienceTechnologies techs={entry.technologies} />}
</Section>

<style scoped>
  ul {
    list-style: none;
    padding-left: 0;
    margin: 0;
  }
</style>