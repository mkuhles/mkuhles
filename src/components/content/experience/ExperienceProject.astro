---
import { getLangFromUrl, getTranslationFunction } from "../../../i18n/utils";
import ExperienceDescription from "./ExperienceDescription.astro";
import ExperienceHeader from "./ExperienceHeader.astro";
import ExperienceTechnologies from "./ExperienceTechnologies.astro";
import type { ExperienceProjectData } from "../../../types/MkuhlesData";

interface Props {
  project: ExperienceProjectData;
}

const { project } = Astro.props as Props;

const curLang = getLangFromUrl(Astro.url);
const t = getTranslationFunction(curLang);
---
<div class="experience-project">
    <ExperienceHeader 
        title={t(project.name)}
        startDate={project.start_date} 
        endDate={project.end_date}
        level={4}
        className="experience-project__header" />
    {project.description &&
      <ExperienceDescription description={project.description} />}
    {project.technologies &&
      <ExperienceTechnologies techs={project.technologies} />}
</div>

<style scoped>
  .experience-project {
    padding: 2rem 0;
    border-top: 1px dashed var(--highlight);

    h4 {
      margin-top: 0;
    }
  }
  :global(.experience-project__header) {
    margin-bottom: 0.125rem;
  }

  :global(li:first-child) .experience-project {
    padding-top: 1rem;
    border-top: none;
  }
</style>
