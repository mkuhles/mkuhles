---
import { getLangFromUrl, getTranslationFunction } from "../../../i18n/utils";

interface Props {
  techs: string[];
}

const {techs} = Astro.props as Props;
const curLang = getLangFromUrl(Astro.url);
const t = getTranslationFunction(curLang);
---
<>
    <h5 class="technologies__title">{t("technologies")}:</h5>
    <ul class="technologies">
    {techs.map((tech: string) => (
        <li>{tech}</li>
    ))}
    </ul>
</> 

<style scoped>
  .technologies__title {
    font-weight: 600;
    margin-top: 0.25rem;
    margin-bottom: 0.25rem;
  }

  ul.technologies {
    list-style: none;
    padding-left: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  
    li {
      display: inline;


      &:not(:last-child) {
        &::after {
          content: ', ';
        }
      }
    }
  }
</style>
