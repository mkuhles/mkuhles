---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  src: ImageMetadata;
  alt?: string;
  widths?: number[];
  sizes?: string;
  loading?: "eager" | "lazy";
  class?: string;
  ratio?: string;
};

const {
  src,
  alt = "",
  widths = [640, 800, 1200, 1600],
  sizes = "(max-width: 767px) 96vw, 45rem",
  loading = "lazy",
  class: className = "",
  ratio = "16/9",
} = Astro.props as Props;

if (!src) {
  throw new Error("PostImage: missing required prop `src` (ImageMetadata).");
}
---

<div class={`media-in-post ${className}`} style={`aspect-ratio: ${ratio};`}>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={loading}
    class={`img-in-post ${className}`}
  />
</div>

<style scoped>
  .media-in-post {
    overflow: hidden;

    border: 1px solid rgba(0,0,0,.12);
    box-shadow:
      0 10px 30px rgba(0,0,0,.20),
      0 2px 8px rgba(0,0,0,.12);
    background: #fff;
  }
  .img-in-post {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    margin: 0;
  }
</style>
