---
import { Image } from "astro:assets";

const {alt, image} = Astro.props;
---

<div class="hero-media">
  <Image
    src={image}
    alt={alt ?? ""}
    formats={["avif", "webp"]}
    widths={[640, 960, 1200]}
    sizes="(max-width: 767px) 100vw, 45rem"
    loading="eager"
    class="hero-img"
  />
</div>

<style scoped>
  .hero-media {
    aspect-ratio: 16 / 7;
    overflow: hidden;
  }
  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
