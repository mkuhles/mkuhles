---
import { getLangFromUrl, getTranslationFunction } from "../../../i18n/utils";
import Button from "./Button.astro";
import AgainIcon from "../icons/again.svg"

const {id, className} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = getTranslationFunction(lang);
---

<Button id={id} title={t('again')} type="highlight" className={className}>
    <AgainIcon />
</Button>