---
interface Props {
  src: string;
  srcset?: string;
  alt?: string;
  className?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  sizes?: string;
  width?: number | string;
  height?: number | string;
  decoding?: "async" | "sync" | "auto";
}
const {
  src,
  srcset,
  alt,
  className,
  loading = "lazy",
  fetchpriority,
  sizes,
  width,
  height,
  decoding = "async",
} = Astro.props;
---
<picture>
  {srcset && <source type="image/webp" srcset={srcset} sizes={sizes} />}
  <img
    src={src}
    alt={alt}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding={decoding}
    sizes={sizes}
    width={width}
    height={height}
    class={className}
  />
</picture>

<style lang="scss" scoped>
img {
    max-width: 100%;
}
.circle {
    border-radius: 50%;
}
</style>
