---
interface Props {
  className?: string;
  styles?: string;
  id?: string;
}

let { className, styles, id } = Astro.props
if (!id) {
  id = 'flip-card-' + Math.random().toString(36).substring(2, 9);
}
--- 

<div 
    class={ (className ?? '') + ' flip-card'}
    style={styles}
    id={id}
    tabindex="0"
    role="button"
    aria-pressed="false"
    aria-describedby={id + '-desc'}
    data-card-id={id}
>
  <!-- Screen-reader-only description of how to interact with the card -->
  <span class="sr-only" id={id + '-desc'}>
    This is a flip card. Press Enter or Space to flip.
  </span>
  <div class='flip-card-inner flip-trigger' aria-label="Vorderseite" id={id + '-inner'}>
    <div class="flip-card-front">
      <slot name="front" />
    </div>
    <div class="flip-card-back flip-trigger" aria-label="Rückseite" style={styles}>
      <slot name="back" />
    </div>
  </div>
</div>

<style lang="scss" scoped>
/* The flip card container */
.flip-card {
  background-color: transparent;
  perspective: 1000px;
}

.flip-card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  text-align: center;
  transition: transform 0.8s;
  transform-style: preserve-3d;
}

/* Do an horizontal flip when you move the mouse over the flip box container */
.flip-card:hover,
.flip-card:focus-within,
.flip-card:focus-visible {
  z-index: 100;

  @media (--medium-up) { 
    .flip-card-inner{
      transform: rotateY(180deg);
    }
  }
}

/* Reduced motion: nicht drehen, siehe dein R-Media-Query */
@media (prefers-reduced-motion: reduce){
  .flip-card-inner{ transition:none; transform:none; }
}

/* Position the front and back side */
.flip-card-front, .flip-card-back {
  position: absolute;
  width: 100%;
  height: 100%;
  -webkit-backface-visibility: hidden; /* Safari */
  backface-visibility: hidden;
  
  display: flex;
  justify-content: center;
  align-items: center;
}

/* Style the back side */
.flip-card-back {
  border-radius: 100%;

  padding: min(6vmin,var(--circle-element-padding));
  width: min(65vmin,20em);
  height: min(65vmin,20em);
  font-size: var(--font-size);

  display: flex;
  justify-content: center;
  align-items: center;

  opacity: 0;
  transition: transform 1s ease, opacity 1s ease; 

  top:50%;
  left:50%;
  transform: translate(-50%, -50%);
    

  @media (--medium-up) {
    transform: translate(-50%, -50%) rotateY(180deg);
    transition: opacity 1s ease;
    width: calc(var(--circle-element-diameter) * 2.2);
    height: calc(var(--circle-element-diameter) * 2.2);
    padding:  calc(var(--circle-element-padding) *2);
  }
}
.flip-card:hover,
.flip-card:focus-visible,
.flip-card:focus,
.flip-card[aria-pressed="true"] {
  .flip-card-back {
    opacity: 1;
  }
}

@media (--small-down) {
  .flip-card-back {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .flip-card.is-open {
    z-index: 9999;
  }

  .flip-card.is-open .flip-card-back {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;

    position: absolute;
    transform: translate(var(--dx), var(--dy));
  }
}
</style>

<script>
  import { toggleCardMobile, requestReflow } from "../../scripts/flip-card";
  import { isSmallScreen } from "../../scripts/media";
  
  document.addEventListener("click", (e) => {
    if (!isSmallScreen()) return;

    const target = e.target instanceof HTMLElement ? e.target : null;
    const card = target?.closest(".flip-card");
    if (!(card instanceof HTMLElement)) return;

    toggleCardMobile(card);
  });

  document.addEventListener("keydown", (e) => {
    if (!isSmallScreen()) return;
    if (e.key !== "Enter" && e.key !== " ") return;

    const card = document.activeElement?.closest?.(".flip-card");
    if (!(card instanceof HTMLElement)) return;

    e.preventDefault();
    toggleCardMobile(card);
  });

  window.addEventListener("resize", requestReflow, { passive: true });
</script>