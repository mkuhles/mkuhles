---
import { getLangFromUrl, getTranslationFunction, getRouteFromUrl, getUrlFromRoute, getUrlFromPath, type RouteKey, LANGS } from "../../i18n/utils";
import NavLink from "./NavLink.astro";

const curLang = getLangFromUrl(Astro.url);
const t = getTranslationFunction(curLang);
const urlFromRoute = getUrlFromRoute(curLang);
const urlFromPath = getUrlFromPath(curLang);
const getRoute = getRouteFromUrl(curLang)

const restPath = Astro.url.pathname.split('/').slice(2).join('/');
const routeKey = getRoute(restPath) // RouteKey | undefined;
const allLanguages = Array.from(LANGS) as (typeof LANGS)[number][];
---

{allLanguages.map((lang) => {
    if(curLang == lang) { return ''; }

    const href = routeKey
        ? urlFromRoute(routeKey as RouteKey, lang)
        : urlFromPath(restPath, lang);

    return (
        <NavLink href={href} title={t('langSwitcher.switch', lang)}>
            {lang}
        </NavLink>
    )
})
}
