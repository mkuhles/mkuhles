---
import NavItem from "./NavItem.astro";
import type { NavEntry } from "../../types/NavItem";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
    className: string,
    navItems: NavEntry[],
};

const { navItems, className} = Astro.props;
---

<nav class={"navbar"+(className ? ` ${className}` : "")}>
    <ul class={"flex justify-center md:justify-end gap-2 flex-wrap list-none"}>
        {navItems.map(item => (
            <NavItem navItem={item} />
        ))}
        <NavItem>
            <LanguageSwitcher />
        </NavItem>
    </ul>
</nav>
