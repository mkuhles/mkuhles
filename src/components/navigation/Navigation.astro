---
import NavItem from "./NavItem.astro";
import type { NavEntry } from "../../types/NavItem";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
    className: string,
    navItems: NavEntry[],
};

const { navItems, className} = Astro.props;
---

<nav class={"navbar"+(className ? ` ${className}` : "")}>
    <ul class="navbar__list">
        {navItems.map(item => (
            <NavItem navItem={item} />
        ))}
        <NavItem>
            <LanguageSwitcher />
        </NavItem>
    </ul>
</nav>

<style scoped>
  .navbar__list {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    list-style: none;
  }
  @media (--medium-up) {
    .navbar__list {
      justify-content: flex-end;
    }
  }
</style>
