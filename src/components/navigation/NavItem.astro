---
import { getLangFromUrl, getUrlFromRoute, getTranslationFunction } from "../../i18n/utils";
import type { NavEntry } from "../../types/NavItem";
import type { UiKey } from "../../i18n/utils";

interface Props {
    navItem?: NavEntry
}

const { navItem } = Astro.props;
const curLang = getLangFromUrl(Astro.url);
const t = getTranslationFunction(curLang);
const getUrl = getUrlFromRoute(curLang);

const href = navItem ? (navItem.href ?? getUrl(navItem.id)) : undefined;
const target = navItem?.href ? "_blank" : undefined;
const label = navItem ? t(`nav.${navItem.id}` as UiKey) : "";
---

<li class="border-2 border-transparent border-b-highlight border-dashed hover:bg-c10 hover:border-highlight">
{navItem ? (
    <a class="block px-0.5 py-0.5" href={href} target={target}>{label}</a>
  ) : (
    <slot />
  )}
</li>