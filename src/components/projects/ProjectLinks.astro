---
import { getLangFromUrl, getTranslationFunction } from "../../i18n/utils";

const { repo, live, showTitle = true, title } = Astro.props;

const curLang = getLangFromUrl(Astro.url);
const t = getTranslationFunction(curLang);
const hasLinks = Boolean(repo || live);
const resolvedTitle = title ?? t("project");
---

{hasLinks && (
  <div class="project-links">
    {showTitle && (
      <div class="project-links__title">{resolvedTitle}</div>
    )}
    <ul>
      {repo && (
        <li>
          <a href={repo} target="_blank" rel="noopener noreferrer">
            {t("github-repo")}
          </a>
        </li>
      )}
      {live && (
        <li>
          <a href={live} target="_blank" rel="noopener noreferrer">
            {t("live-url")}
          </a>
        </li>
      )}
    </ul>
  </div>
)}

<style scoped>
.project-links {
  font-style: italic;
  padding: .5rem .625rem;
  border: 1px solid var(--c8-transparent-02);
  background-color: var(--c8-transparent-02);
  font-size: .875rem;
  
  @media (--medium-up) {
    width: fit-content;
    max-width: 12.5rem;
  }
}
.project-links__title {
  font-weight: 600;
  margin-bottom: 0.5rem;
}
.project-links ul {
  margin: 0;
  padding-left: 1em;
  list-style: "> ";

  li::marker {
    color: var(--highlight);
  }
}
</style>
