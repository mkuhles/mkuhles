---
import "../styles/tailwind.css";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

const {
	title,
	lang,
	description,
	ogImage,
	ogType = "website",
	canonical,
	alternates = [],
} = Astro.props;

const canonicalUrl = canonical ?? Astro.url?.href;
const baseUrl = Astro.site ?? Astro.url;
const ogImageUrl =
	ogImage && baseUrl ? new URL(ogImage, baseUrl).toString() : ogImage;
const twitterCard = ogImageUrl ? "summary_large_image" : "summary";
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		{alternates.map((alt: { lang: string; href: string }) => (
			<link rel="alternate" hreflang={alt.lang} href={alt.href} />
		))}
		{description && <meta name="description" content={description} />}
		<meta property="og:type" content={ogType} />
		{title && <meta property="og:title" content={title} />}
		{description && <meta property="og:description" content={description} />}
		{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
		<meta name="twitter:card" content={twitterCard} />
		{title && <meta name="twitter:title" content={title} />}
		{description && <meta name="twitter:description" content={description} />}
		{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
	</head>
	<body>
		<Header pageTitle={title} lang={lang} />
        <main>
            <slot />
        </main>
        <Footer lang={lang} />
	</body>
</html>

<script>
// CSS-Variablen sind jetzt in src/styles/_variables.scss definiert
</script>
