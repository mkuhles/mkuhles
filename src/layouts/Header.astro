---
import type { NavEntry } from "../types/NavItem.ts";
import Navigation from "../components/layout/Navigation.astro";

import navData from '../data/nav/navigation.json';
const nav = navData satisfies NavEntry[];
---

<header class="py-1 px-2 flex justify-between items-center">
    <div class="logo__wrapper">
        <a href="/">
            <img src="/images/logo.svg" alt="Website Logo" />
        </a>
    </div>
    <Navigation className="header-nav" navItems={nav} /> 
</header>

<style>
    header {
      background:var(--c9); color:var(--text-color-inv);
    }
    .logo__wrapper img {
      width: 15vmin;
      border-radius: 50%;
    
      @media screen and (min-width: 500px) {  
        width: 8vmin;
      } 
    }
</style>
