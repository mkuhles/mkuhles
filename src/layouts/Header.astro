---
import type { NavEntry } from "../types/NavItem.ts";
import Navigation from "../components/navigation/Navigation.astro";

import navData from '../data/navigation.json';
import Section from "./Section.astro";
import { getUrlFromRoute } from "../i18n/utils";
import type { Lang } from "../i18n/types";

const { lang } = Astro.props as { lang: Lang; pageTitle?: string };
const urlFromRoute = getUrlFromRoute(lang);

const nav = (navData as any).main as NavEntry[];

const base = import.meta.env.BASE_URL;
---

<header>
    <Section type="header" className="header-section" contentClassName="header-content">
      <div class="logo__wrapper">
          <a href={urlFromRoute("home")}>
              <img src={`${base}images/logo.svg`} alt="Website Logo" />
          </a>
      </div>
      <Navigation className="header-nav" navItems={nav} lang={lang} /> 
    </Section>
</header>

<style scoped>
    header {
      background:var(--c9); color:var(--text-color-inv);
    }
    :global(.header-section) {
      padding: 0.25rem 0;
    }
    :global(.header-content) {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }
    .logo__wrapper img {
      width: 15vmin;
      height: auto;
      border-radius: 50%;
      display: block;
    
      @media screen and (min-width: 500px) {  
        width: 8vmin;
      } 
    }
</style>
