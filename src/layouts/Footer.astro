---
import type { NavEntry } from "../types/NavItem.ts";
import Navigation from "../components/layout/Navigation.astro";

import navData from '../data/navigation.json';
const nav = (navData as any).footer as NavEntry[];
const currentYear = new Date().getFullYear();
---

<footer class="py-1 px-2 flex justify-between items-center">
    <div><p>© {currentYear} Melanie Kuhles</p></div>
    <Navigation className="footer-nav" navItems={nav} />
</footer>


<style>
    footer {
      background:var(--c9); color:var(--text-color-inv);
    }
</style>