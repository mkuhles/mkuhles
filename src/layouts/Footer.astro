---
import type { NavEntry } from "../types/NavItem.ts";
import Navigation from "../components/navigation/Navigation.astro";

import navData from '../data/navigation.json';
const nav = (navData as any).footer as NavEntry[];
const currentYear = new Date().getFullYear();
---

<footer class="px-2 md:flex justify-between items-center">
    <Navigation className="footer-nav my-2" navItems={nav} />
    <div class="my-2 text-center md:text-left order-first"><p>© {currentYear} Melanie Kuhles</p></div>
</footer>


<style>
    footer {
      background:var(--c9); color:var(--text-color-inv);
    }
</style>