---
import type { NavEntry } from "../types/NavItem.ts";
import Navigation from "../components/navigation/Navigation.astro";

import navData from '../data/navigation.json';
import Section from "./Section.astro";
const nav = (navData as any).footer as NavEntry[];
const currentYear = new Date().getFullYear();
---

<footer>
    <Section type="footer" className="footer-section" contentClassName="footer-content">
        <Navigation className="footer-nav" navItems={nav} />
        <div class="footer-copy"><p>© {currentYear} Melanie Kuhles</p></div>
    </Section>
</footer>


<style>
    footer {
      background:var(--c9);
      color:var(--text-color-inv);

      @media (--small-down) {
        padding-bottom: calc(1rem + var(--btn-min-size));
      }
    }
    :global(.footer-section) {
      padding: 0;
    }
    :global(.footer-content) {
      @media (--medium-up) {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
    }
    :global(.footer-nav) {
      ul {
        margin: 0;
        padding: 0;
      }
      @media (--medium-up) {
        order: 1;
      }
    }
    .footer-copy {
      margin: 2rem 0;
      text-align: center;
      order: -1;
      @media (--medium-up) {
        text-align: left;
        order: 0;
        margin: 0;
      }
    }
</style>
