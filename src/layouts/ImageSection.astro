---
import "../styles/layouts/section.scss";
import Image from '../components/shared/Image.astro';
import Section from "./Section.astro";

interface Props {
    type?: string;
    id?: string;
    className?: string;
    image?: {
        src: string;
        srcset: string;
        alt: string;
        className?: string;
        loading?: "eager" | "lazy";
        fetchpriority?: "high" | "low" | "auto";
        sizes?: string;
        width?: number | string;
        height?: number | string;
        decoding?: "async" | "sync" | "auto";
    },
}

let { type, id = '', image, className } = Astro.props;
---

<Section type={type} id={id} className={className}>
        {image && 
            <div class="section__image">
                <Image
                    src={image.src}
                    srcset={image.srcset}
                    alt={image.alt}
                    className={image.className}
                    loading={image.loading}
                    fetchpriority={image.fetchpriority}
                    sizes={image.sizes}
                    width={image.width}
                    height={image.height}
                    decoding={image.decoding}
                />
            </div>
        }
        <div class="section__text">
            <slot />
        </div>
</Section>
