---
import "../styles/layouts/section.css";
import Image from '../components/shared/Image.astro';
import Section from "./Section.astro";
import type { ImageSectionImage } from "../types/ImageSectionImage";

interface Props {
    type?: string;
    id?: string;
    className?: string;
    image?: ImageSectionImage,
}

let { type, id = '', image, className } = Astro.props;
---

<Section type={type} id={id} className={className}>
        {image && 
            <div class="section__image">
                <Image
                    src={image.src}
                    srcset={image.srcset}
                    alt={image.alt}
                    className={image.className}
                    loading={image.loading}
                    fetchpriority={image.fetchpriority}
                    sizes={image.sizes}
                    width={image.width}
                    height={image.height}
                    decoding={image.decoding}
                />
            </div>
        }
        <div class="section__text">
            <slot />
        </div>
</Section>

<style scoped>
    .section__image {
        margin-bottom: 1rem;
        display: flex;
        justify-content: center;
    }
    @media (--medium-up) {
        .section__image {
            margin-bottom: 0;
        }
    }
</style>
