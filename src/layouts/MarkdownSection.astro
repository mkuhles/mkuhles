---
import { getLangFromUrl } from '../i18n/utils';
import Section from './Section.astro';

interface Props {
    type?: string;
    id?: string;
    className?: string;
}

let { type, className, id } = Astro.props;
const curLang = getLangFromUrl(Astro.url);
---

<Section type={type} id={id} className={className}>
  <article class={"prose " + curLang}>
    <slot />
  </article>
</Section>