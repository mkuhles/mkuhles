---
import "../styles/layouts/section.scss";

interface Props {
    type?: string;
    id?: string;
    className?: string;
    contentClassName?: string;
}

let { type, id = ''} = Astro.props;
const className = 'section'
    + (type ? ` section--${type}` : '') 
    + (Astro.props.className ? ` ${Astro.props.className}` : '');
const contentClass = 'section__content'
    + (Astro.props.contentClassName ? ` ${Astro.props.contentClassName}` : '');
---

<section class={className} id={id}>
        <div class={contentClass}>
        <slot />
    </div>
</section>